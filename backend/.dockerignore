# Never bake secrets or local env files into the image.
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Python virtual environment / caches (installed fresh inside the image)
.venv
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests are not needed in the runtime image
tests/
test_model.py

# Editor/OS cruft
.DS_Store
.vscode/
.idea/

# Docker files themselves
Dockerfile
.dockerignore
